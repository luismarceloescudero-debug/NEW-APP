# Copiá este archivo a ".env" para desarrollo local (Vercel CLI: `vercel dev`),
# o cargá estas variables en el panel de Environment Variables de Vercel/Netlify
# para producción. NUNCA subas un archivo ".env" real al repositorio (ya está
# en .gitignore).

# Proveedor de IA. "ollama" es local, sin API key ni cuota; "anthropic" es remoto y de pago.
AI_PROVIDER=ollama

# Ollama local. Instalá Ollama y descargá el modelo antes de usarlo:
#   ollama pull qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=10m
# OLLAMA_NUM_CTX=8192

# API key de Anthropic (Consola de Anthropic -> console.anthropic.com -> API Keys).
# Esto NO es tu suscripción de claude.ai (Pro/Max) -- es una API separada, facturada
# por uso, necesaria para que /api/chat.js pueda llamar a Claude.
ANTHROPIC_API_KEY=

# Control anti-abuso básico. No es autenticación: el valor también se descarga
# en el JavaScript del navegador. Para seguridad real usar login o protección
# del despliegue. Debe coincidir con APP_SECRET_VALUE del frontend.
APP_SHARED_SECRET=CONFIGURE_REMOTE_AUTHENTICATION_FIRST

# Opcional. Modelo a usar. Por defecto: claude-sonnet-5.
# Alternativa más económica: claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-5

# Opcional. Tope de búsquedas web (tool "web_search") que Claude puede hacer POR MENSAJE
# del usuario. Cada búsqueda cuesta aparte (~USD 10 cada 1000, ver console.anthropic.com).
# Por defecto: 0. Usar un valor bajo solo después de configurar presupuesto y alertas.
ANTHROPIC_MAX_WEB_SEARCHES=0
